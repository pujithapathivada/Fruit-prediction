# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Environments
.env
.venv

# Model weights & large binaries (keep the directory structure, ignore binaries)
models/*.keras
models/*.h5
models/*.tflite
models/*.pb
models/variables/
!models/.gitkeep

# Datasets (do not commit raw dataset files to git)
dataset/*
!dataset/README.md
!dataset/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
